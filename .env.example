# Public-safe example configuration. Do not commit real credentials.
CALL_HOST_PORT=8848
CODEX_MODEL=gpt-5.6-sol
CODEX_EFFORT=low
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_v4_turbo

# Optional quota dashboard. Leave off if usage numbers make the call less relaxing.
CALL_PROVIDER_USAGE_ENABLED=0
ASSEMBLYAI_RATE_USD_PER_HOUR=0.45
ELEVENLABS_USAGE_API_KEY_FILE=/data/secrets/elevenlabs-usage-api-key

TENCENT_TRTC_SDK_APP_ID=0

# Optional adapters for cross-channel continuity and proactive push calling.
COMPANION_BRIDGE_BASE=
PUSH_SERVICE_URL=
